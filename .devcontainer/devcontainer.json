{
  "name": "OrigenLM",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb"
  },
  "postCreateCommand": "python -m pip install -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  },
  "forwardPorts": [
    3001
  ],
  "portsAttributes": {
    "3001": {
      "label": "OrigenLM - Chat",
      "onAutoForward": "notify"
    }
  }
}
