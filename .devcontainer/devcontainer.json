{
  "name": "OrigenLM - entrenamiento propio (CPU)",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  },
  "postCreateCommand": "bash scripts/bootstrap_codespaces.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  }
}
