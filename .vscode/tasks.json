{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "All Services (OrigenLM)",
      "type": "shell",
      "command": "bash scripts/start_services.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "group": "build"
    },
    {
      "label": "Stop Services (OrigenLM)",
      "type": "shell",
      "command": "bash scripts/stop_services.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Status Services (OrigenLM)",
      "type": "shell",
      "command": "bash scripts/status_services.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
