#!/usr/bin/env bash
set -euo pipefail
SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SCRIPT")/.." && pwd -P)"
cd "$ROOT"

# Sincronizar al abrir OrigenLM, no durante entrenamiento.
# Nunca sobrescribir cambios locales ni forzar merges.
if [[ "${ORIGEN_NO_SYNC:-0}" != "1" ]] && command -v git >/dev/null 2>&1; then
  branch="$(git -C "$ROOT" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  dirty="$(git -C "$ROOT" status --porcelain --untracked-files=no 2>/dev/null || true)"
  if [[ "$branch" == "main" && -z "$dirty" ]] && git -C "$ROOT" remote get-url origin >/dev/null 2>&1; then
    echo "[OrigenLM] Buscando actualizaciones de GitHub..." >&2
    if ! GIT_TERMINAL_PROMPT=0 timeout 20 git -C "$ROOT" pull --ff-only --quiet origin main; then
      echo "[OrigenLM] Sincronización omitida o fallida; usando la copia local." >&2
    fi
  else
    echo "[OrigenLM] Sincronización omitida: cambios locales o rama distinta de main." >&2
  fi
fi

if command -v python >/dev/null 2>&1 && python -c 'import torch' >/dev/null 2>&1; then
  PYTHON="$(command -v python)"
elif [[ -x "$ROOT/.venv/bin/python" ]] && "$ROOT/.venv/bin/python" -c 'import torch' >/dev/null 2>&1; then
  PYTHON="$ROOT/.venv/bin/python"
else
  echo "[OrigenLM] Falta un Python con PyTorch; revisa scripts/bootstrap_codespaces.sh" >&2
  exit 1
fi
exec "$PYTHON" -m origen.cli "$@"
